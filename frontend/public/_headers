# Cloudflare Pages 헤더 설정 — vercel.json 의 headers 를 대체.
# 정적 자산에만 적용된다 (Pages Function 응답에는 미적용).

/*
  X-Robots-Tag: noindex, nofollow, noarchive

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# self-host 폰트 — 디렉터리 이름에 버전이 있어 내용이 바뀌지 않는다 (src/styles/pretendard.css)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 테마별 히어로·카드 삽화(URL 고정, 가끔 교체). Pages 기본값(max-age=0, must-revalidate)이면
# 이미 받은 반대 테마 파일도 토글마다 조건부 요청 한 왕복이 생긴다(서비스 워커 통제 전·첫 방문).
# 하루는 그대로 쓰고, 그 뒤 일주일은 옛 파일을 먼저 보여주며 뒤에서 갱신한다 —
# 그림을 다시 구우면 최대 하루 안에 새 파일로 바뀐다. 서비스 워커(sw.js)의
# stale-while-revalidate 와 같은 정책이라 두 캐시가 서로 어긋나지 않는다.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Vite 빌드 산출물 — 파일명에 콘텐츠 해시가 있어 같은 URL 의 내용은 절대 바뀌지 않는다.
# Pages 기본값(max-age=0, must-revalidate)이면 서비스 워커가 통제하기 전(첫 방문·새 탭·
# SW 프리캐시 fetch)에 청크마다 304 왕복이 생긴다. 재배포는 index.html 이 새 해시를
# 가리키므로 immutable 이어도 갱신에 문제가 없다 (/fonts/* 와 같은 근거).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 집중기도 앰비언스 mp3(총 26MB, 파일명 고정·내용 불변). 기본값이면 재생할 때마다
# 수 MB 파일에 조건부 요청 한 왕복이 붙는다. 서비스 워커 정규식에도 mp3 가 없어
# 브라우저 HTTP 캐시가 유일한 캐시 계층이다.
/sounds/*
  Cache-Control: public, max-age=31536000, immutable
